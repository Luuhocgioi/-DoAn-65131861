@model QuanLyGara.Models.DonHang

@{
    ViewData["Title"] = "Chi Tiết Giao Dịch";
}

<style>
    :root {
        --primary-color: #2b2d42;
        --accent-color: #ef233c;
        --bg-color: #0f1115;
    }

    .details-wrapper {
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 20px 0;
    }

    .glass-console {
        background: rgba(255, 255, 255, 0.02);
        backdrop-filter: blur(25px);
        -webkit-backdrop-filter: blur(25px);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 28px;
        padding: 40px;
        width: 100%;
        max-width: 900px;
        box-shadow: 0 25px 50px rgba(0,0,0,0.5);
    }

    .console-header {
        text-align: center;
        margin-bottom: 40px;
    }

    .console-icon {
        font-size: 3.5rem;
        color: var(--accent-color);
        margin-bottom: 10px;
        filter: drop-shadow(0 0 10px rgba(239, 35, 60, 0.5));
    }

    .console-title {
        font-size: 2rem;
        font-weight: 900;
        color: #fff;
        letter-spacing: 1px;
        text-transform: uppercase;
        margin: 0;
    }

    .console-subtitle {
        color: #8d97ad;
        font-size: 0.95rem;
        margin-top: 5px;
    }

    /* Bố cục 2 cột */
    .details-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 30px;
        margin-bottom: 40px;
    }

    @@media (max-width: 768px) {
        .details-grid {
            grid-template-columns: 1fr;
        }
    }

    .column-title {
        font-size: 1.1rem;
        font-weight: 800;
        color: #00f2fe; /* Cyan */
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 20px;
        border-bottom: 1px solid rgba(0, 242, 254, 0.15);
        padding-bottom: 10px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .info-list {
        display: flex;
        flex-direction: column;
        gap: 15px;
    }

    .info-row {
        display: flex;
        align-items: center;
        background: rgba(255, 255, 255, 0.01);
        border: 1px solid rgba(255, 255, 255, 0.03);
        padding: 12px 18px;
        border-radius: 12px;
        gap: 12px;
    }

    .info-icon {
        font-size: 1.3rem;
        color: var(--accent-color);
    }

    .info-content {
        display: flex;
        flex-direction: column;
    }

    .info-label {
        font-size: 0.75rem;
        color: #8d97ad;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .info-value {
        font-size: 1rem;
        font-weight: 700;
        color: #fff;
        margin-top: 1px;
    }

    .price-value {
        color: #ef233c !important; /* Giá chốt màu đỏ nổi bật */
        font-size: 1.3rem !important;
        font-weight: 900 !important;
    }

    /* Khung ảnh xe */
    .car-photo-box {
        width: 100%;
        height: 200px;
        border-radius: 16px;
        overflow: hidden;
        border: 1px solid rgba(255, 255, 255, 0.05);
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.3);
        margin-top: 20px;
    }

    .car-photo-box img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .action-footer {
        display: flex;
        gap: 20px;
        border-top: 1px dashed rgba(255,255,255,0.1);
        padding-top: 30px;
    }

    .btn-back-glass {
        flex: 1;
        background: rgba(255,255,255,0.05);
        color: #fff;
        border: 1px solid rgba(255,255,255,0.1);
        padding: 14px;
        border-radius: 12px;
        font-weight: 600;
        text-align: center;
        text-decoration: none;
        transition: all 0.3s;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

    .btn-back-glass:hover {
        background: rgba(255,255,255,0.1);
        color: #fff;
        transform: translateX(-3px);
    }

    .btn-edit-neon {
        flex: 1;
        background: var(--accent-color);
        color: #fff;
        border: none;
        padding: 14px;
        border-radius: 12px;
        font-weight: 800;
        font-size: 1rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        transition: all 0.3s;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        box-shadow: 0 8px 25px rgba(239, 35, 60, 0.4);
        text-decoration: none;
    }

    .btn-edit-neon:hover {
        background: #d90429;
        transform: translateY(-3px);
        box-shadow: 0 12px 30px rgba(239, 35, 60, 0.6);
        color: #fff;
    }
</style>

<div class="details-wrapper">
    <div class="glass-console">

        <div class="console-header">
            <i class='bx bx-receipt console-icon'></i>
            <h2 class="console-title">HỒ SƠ GIAO DỊCH</h2>
            <p class="console-subtitle">Chi tiết hợp đồng mua bán mã số #@Model.Id</p>
        </div>

        <div class="details-grid">
            <!-- Cột trái: Thông tin hợp đồng & nhân sự -->
            <div>
                <h3 class="column-title"><i class='bx bx-file-blank'></i> Hợp Đồng & Nhân Sự</h3>
                <div class="info-list">
                    <div class="info-row">
                        <i class='bx bx-calendar info-icon'></i>
                        <div class="info-content">
                            <span class="info-label">Ngày Lập Hợp Đồng</span>
                            <span class="info-value">@Model.NgayLap?.ToString("dd/MM/yyyy - HH:mm:ss")</span>
                        </div>
                    </div>

                    <div class="info-row">
                        <i class='bx bx-dollar-circle info-icon'></i>
                        <div class="info-content">
                            <span class="info-label">Giá Trị Chốt Giao Dịch</span>
                            <span class="info-value price-value">@Model.GiaChot.ToString("N0") VNĐ</span>
                        </div>
                    </div>

                    <div class="info-row">
                        <i class='bx bx-user-voice info-icon'></i>
                        <div class="info-content">
                            <span class="info-label">Nhân Viên Phụ Trách</span>
                            <span class="info-value">@Model.NhanVien?.HoTen (@Model.NhanVien?.ChucVu)</span>
                        </div>
                    </div>
                    
                    <div class="info-row">
                        <i class='bx bx-phone-call info-icon'></i>
                        <div class="info-content">
                            <span class="info-label">Số điện thoại liên hệ</span>
                            <span class="info-value">@Model.NhanVien?.SoDienThoai</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Cột phải: Thông tin xe bán -->
            <div>
                <h3 class="column-title"><i class='bx bx-car'></i> Chi Tiết Phương Tiện</h3>
                <div class="info-list">
                    <div class="info-row">
                        <i class='bx bxs-purchase-tag info-icon'></i>
                        <div class="info-content">
                            <span class="info-label">Thương Hiệu & Dòng Xe</span>
                            <span class="info-value">@Model.Xe?.HangXe @Model.Xe?.DongXe</span>
                        </div>
                    </div>

                    <div class="info-row">
                        <i class='bx bx-fingerprint info-icon'></i>
                        <div class="info-content">
                            <span class="info-label">Số Khung Số Máy (VIN)</span>
                            <span class="info-value">@Model.Xe?.SoKhungSoMay</span>
                        </div>
                    </div>

                    <div class="info-row">
                        <i class='bx bx-money-withdraw info-icon'></i>
                        <div class="info-content">
                            <span class="info-label">Giá Niêm Yết Showroom</span>
                            <span class="info-value">@Model.Xe?.GiaBan.ToString("N0") VNĐ</span>
                        </div>
                    </div>
                </div>

                <!-- Ảnh Xe -->
                <div class="car-photo-box">
                    @if (Model.Xe?.HinhAnhXes != null && Model.Xe.HinhAnhXes.Any())
                    {
                        var anhChinh = Model.Xe.HinhAnhXes.FirstOrDefault(a => a.LaAnhChinh == true) ?? Model.Xe.HinhAnhXes.First();
                        <img src="@anhChinh.DuongDanAnh" alt="Xe" />
                    }
                    else
                    {
                        <div class="d-flex align-items-center justify-content-center h-100 w-100" style="background: rgba(255,255,255,0.02); color: #8d97ad;">
                            <i class='bx bx-image-alt fs-1'></i>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="action-footer">
            <a asp-action="Index" class="btn-back-glass">
                <i class='bx bx-arrow-back'></i> Quay lại
            </a>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-edit-neon">
                <i class='bx bxs-edit-alt'></i> Chỉnh sửa hợp đồng
            </a>
        </div>

    </div>
</div>
