@model QuanLyGara.Models.DonHang

@{
    ViewData["Title"] = "Hủy Giao Dịch";
}

<style>
    :root {
        --primary-color: #2b2d42;
        --accent-color: #ef233c;
        --bg-color: #0f1115;
    }

    .delete-wrapper {
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 20px 0;
    }

    .glass-console {
        background: rgba(255, 255, 255, 0.02);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 24px;
        padding: 40px;
        width: 100%;
        max-width: 650px;
        box-shadow: 0 25px 50px rgba(0,0,0,0.5);
        text-align: center;
    }

    .warning-icon {
        font-size: 4rem;
        color: var(--accent-color);
        margin-bottom: 20px;
        filter: drop-shadow(0 0 15px rgba(239, 35, 60, 0.4));
    }

    .delete-title {
        font-size: 1.8rem;
        font-weight: 950;
        color: #fff;
        letter-spacing: 1px;
        text-transform: uppercase;
        margin-bottom: 10px;
    }

    .delete-subtitle {
        color: #8d97ad;
        font-size: 0.95rem;
        margin-bottom: 30px;
    }

    /* Bảng thông số tóm tắt */
    .summary-box {
        background: rgba(255, 255, 255, 0.01);
        border: 1px solid rgba(255, 255, 255, 0.03);
        border-radius: 16px;
        padding: 25px;
        text-align: left;
        margin-bottom: 30px;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .summary-row {
        display: flex;
        justify-content: space-between;
        border-bottom: 1px solid rgba(255,255,255,0.02);
        padding-bottom: 8px;
        font-size: 0.95rem;
    }

    .summary-row span:first-child {
        color: #8d97ad;
    }

    .summary-row span:last-child {
        color: #ffffff;
        font-weight: 700;
    }

    .price-value {
        color: var(--accent-color) !important;
        font-size: 1.2rem;
        font-weight: 900 !important;
    }

    .alert-warn-box {
        background: rgba(239, 35, 60, 0.08);
        border-left: 4px solid var(--accent-color);
        padding: 20px;
        border-radius: 0 12px 12px 0;
        text-align: left;
        margin-bottom: 40px;
    }

    .alert-warn-title {
        color: #ff4d6d;
        font-weight: 700;
        font-size: 0.95rem;
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 6px;
        text-transform: uppercase;
    }

    .alert-warn-text {
        color: rgba(255,255,255,0.7);
        font-size: 0.85rem;
        line-height: 1.5;
        margin: 0;
    }

    .action-footer {
        display: flex;
        gap: 20px;
        border-top: 1px dashed rgba(255,255,255,0.1);
        padding-top: 30px;
    }

    .btn-back-glass {
        flex: 1;
        background: rgba(255,255,255,0.05);
        color: #fff;
        border: 1px solid rgba(255,255,255,0.1);
        padding: 14px;
        border-radius: 12px;
        font-weight: 600;
        text-align: center;
        text-decoration: none;
        transition: all 0.3s;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

    .btn-back-glass:hover {
        background: rgba(255,255,255,0.1);
        color: #fff;
        transform: translateX(-3px);
    }

    .btn-delete-neon {
        flex: 2;
        background: var(--accent-color);
        color: #fff;
        border: none;
        padding: 14px;
        border-radius: 12px;
        font-weight: 800;
        font-size: 1rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        transition: all 0.3s;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        box-shadow: 0 8px 25px rgba(239, 35, 60, 0.4);
        cursor: pointer;
    }

    .btn-delete-neon:hover {
        background: #d90429;
        transform: translateY(-3px);
        box-shadow: 0 12px 30px rgba(239, 35, 60, 0.6);
    }
</style>

<div class="delete-wrapper">
    <div class="glass-console">

        <i class='bx bx-trash warning-icon'></i>
        <h2 class="delete-title">HỦY GIAO DỊCH</h2>
        <p class="delete-subtitle">Bạn có chắc chắn muốn hủy bỏ hợp đồng giao dịch này?</p>

        <div class="summary-box">
            <div class="summary-row">
                <span>Số Hóa Đơn (Mã ID)</span>
                <span>#@Model.Id</span>
            </div>
            <div class="summary-row">
                <span>Mẫu Xe Giao Dịch</span>
                <span>@Model.Xe?.HangXe @Model.Xe?.DongXe</span>
            </div>
            <div class="summary-row">
                <span>Nhân Viên Phụ Trách</span>
                <span>@Model.NhanVien?.HoTen</span>
            </div>
            <div class="summary-row">
                <span>Ngày Lập Đơn</span>
                <span>@Model.NgayLap?.ToString("dd/MM/yyyy - HH:mm:ss")</span>
            </div>
            <div class="summary-row" style="border: none;">
                <span>Giá Trị Hợp Đồng</span>
                <span class="price-value">@Model.GiaChot.ToString("N0") VNĐ</span>
            </div>
        </div>

        <div class="alert-warn-box">
            <div class="alert-warn-title">
                <i class='bx bxs-error-alt fs-5'></i> Lưu ý nghiệp vụ đặc biệt
            </div>
            <p class="alert-warn-text">
                Khi thực hiện **HỦY GIAO DỊCH**, hệ thống sẽ tự động chuyển trạng thái của xe **@Model.Xe?.HangXe @Model.Xe?.DongXe** quay lại trạng thái **"Sẵn sàng bán"** và giảm trừ doanh thu chốt của gara.
            </p>
        </div>

        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <div class="action-footer">
                <a asp-action="Index" class="btn-back-glass">
                    <i class='bx bx-arrow-back'></i> Hủy Bỏ
                </a>
                <button type="submit" class="btn-delete-neon">
                    <i class='bx bx-check-shield'></i> ĐỒNG Ý HỦY GIAO DỊCH
                </button>
            </div>
        </form>

    </div>
</div>
