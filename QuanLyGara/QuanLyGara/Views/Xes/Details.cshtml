@model QuanLyGara.Models.Xe

@{
    ViewData["Title"] = "Phân Tích Dữ Liệu: " + Model.DongXe;
}
<link href="https://cdn.jsdelivr.net/npm/boxicons@latest/css/boxicons.min.css" rel="stylesheet">
<style>
    :root {
        --primary-color: #2b2d42;
        --accent-color: #ef233c;
        --bg-color: #0f1115; /* Nền tối đồng bộ */
    }

    .vr-profile-container {
        padding: 20px 0;
        color: #fff;
    }

    /* Tiêu đề & Nút Quay lại */
    .profile-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        margin-bottom: 40px;
        border-bottom: 1px solid rgba(255,255,255,0.05);
        padding-bottom: 20px;
    }

    .page-title {
        font-size: 2.2rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 2px;
        background: linear-gradient(90deg, #fff, #00f2fe);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        margin: 0;
    }

    .btn-back-neon {
        background: rgba(255,255,255,0.05);
        color: #fff;
        border: 1px solid rgba(255,255,255,0.1);
        padding: 12px 25px;
        border-radius: 50px;
        font-weight: 600;
        transition: all 0.3s;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

        .btn-back-neon:hover {
            background: rgba(255,255,255,0.1);
            color: #fff;
            transform: translateX(-5px);
            box-shadow: 0 0 15px rgba(255,255,255,0.1);
        }

    /* KHU VỰC TRÁI: MÀN HÌNH QUÉT ẢNH (Glass Gallery) */
    .glass-gallery {
        background: rgba(255, 255, 255, 0.02);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 24px;
        padding: 20px;
        box-shadow: 0 20px 40px rgba(0,0,0,0.5);
        height: 100%;
        position: relative;
        overflow: hidden;
    }

        /* Hiệu ứng quét Radar trên ảnh */
        .glass-gallery::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(to bottom, transparent, rgba(0, 242, 254, 0.05), transparent);
            animation: radarScan 3s infinite linear;
            pointer-events: none;
            z-index: 5;
        }

    @@keyframes radarScan {
        0% {
            transform: translateY(-100%);
        }

        100% {
            transform: translateY(100%);
        }
    }

    .main-image-container {
        width: 100%;
        height: 450px;
        border-radius: 16px;
        overflow: hidden;
        margin-bottom: 20px;
        position: relative;
        background: rgba(0,0,0,0.5);
        border: 1px solid rgba(255,255,255,0.1);
    }

    .main-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.5s ease;
        filter: contrast(1.1) saturate(1.1);
    }

    .main-image-container:hover .main-image {
        transform: scale(1.08);
    }

    .star-badge {
        position: absolute;
        top: 15px;
        left: 15px;
        background: rgba(239, 35, 60, 0.8);
        backdrop-filter: blur(5px);
        color: #fff;
        padding: 8px 15px;
        border-radius: 50px;
        font-weight: 700;
        font-size: 0.85rem;
        border: 1px solid rgba(255,255,255,0.2);
        box-shadow: 0 0 15px rgba(239, 35, 60, 0.5);
        z-index: 10;
    }

    .thumbnail-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(85px, 1fr));
        gap: 15px;
    }

    .thumbnail {
        height: 75px;
        border-radius: 12px;
        overflow: hidden;
        cursor: pointer;
        border: 2px solid transparent;
        transition: all 0.3s;
        opacity: 0.6;
    }

        .thumbnail:hover, .thumbnail.active {
            border-color: #00f2fe;
            opacity: 1;
            transform: translateY(-3px);
            box-shadow: 0 5px 15px rgba(0, 242, 254, 0.3);
        }

        .thumbnail img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    /* KHU VỰC PHẢI: BẢNG PHÂN TÍCH DỮ LIỆU (Cyber Specs) */
    .cyber-specs-card {
        background: rgba(255, 255, 255, 0.02);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 24px;
        padding: 40px;
        box-shadow: 0 20px 40px rgba(0,0,0,0.5);
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .brand-text {
        color: #8d97ad;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 3px;
        font-size: 1rem;
        margin-bottom: 5px;
    }

    .model-name {
        font-size: 2.8rem;
        font-weight: 900;
        color: #fff;
        margin-bottom: 25px;
        line-height: 1.1;
    }

    .cyber-price-tag {
        font-size: 2.8rem;
        font-weight: 900;
        color: var(--accent-color);
        margin-bottom: 10px;
        text-shadow: 0 0 20px rgba(239, 35, 60, 0.4);
    }

        .cyber-price-tag span {
            font-size: 1.2rem;
            color: rgba(255,255,255,0.5);
            font-weight: 600;
        }

    /* Badge Trạng Thái */
    .vr-status-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 25px;
        border-radius: 50px;
        font-weight: 800;
        font-size: 0.95rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-top: 15px;
        margin-bottom: 30px;
    }

    .status-available {
        background: rgba(0, 242, 254, 0.1);
        color: #00f2fe;
        border: 1px solid rgba(0, 242, 254, 0.3);
        box-shadow: 0 0 15px rgba(0, 242, 254, 0.2);
    }

    .status-sold {
        background: rgba(239, 35, 60, 0.1);
        color: var(--accent-color);
        border: 1px solid rgba(239, 35, 60, 0.3);
        box-shadow: 0 0 15px rgba(239, 35, 60, 0.2);
    }

    /* Lưới Thông Số */
    .specs-grid {
        display: flex;
        flex-direction: column;
        gap: 20px;
        margin-top: 20px;
        padding-top: 30px;
        border-top: 1px dashed rgba(255,255,255,0.1);
    }

    .cyber-spec-item {
        display: flex;
        align-items: center;
        background: rgba(0,0,0,0.3);
        padding: 15px 20px;
        border-radius: 16px;
        border: 1px solid rgba(255,255,255,0.05);
        transition: all 0.3s;
    }

        .cyber-spec-item:hover {
            background: rgba(0,0,0,0.5);
            border-color: rgba(255,255,255,0.15);
            transform: translateX(5px);
        }

    .spec-icon-vr {
        width: 50px;
        height: 50px;
        background: rgba(255,255,255,0.05);
        color: #00f2fe;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.6rem;
        margin-right: 20px;
    }

    .spec-details {
        display: flex;
        flex-direction: column;
    }

    .spec-label-vr {
        font-size: 0.85rem;
        color: #8d97ad;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 3px;
    }

    .spec-value-vr {
        font-size: 1.2rem;
        font-weight: 700;
        color: #fff;
    }

    /* Nút Thao Tác Edit */
    .action-group-vr {
        margin-top: auto;
        padding-top: 40px;
    }

    .btn-edit-neon {
        width: 100%;
        background: #00f2fe;
        color: #0f1115;
        border: none;
        border-radius: 15px;
        padding: 18px;
        font-weight: 900;
        font-size: 1.1rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        transition: all 0.3s;
        text-decoration: none;
        box-shadow: 0 10px 30px rgba(0, 242, 254, 0.3);
    }

        .btn-edit-neon:hover {
            background: #00d4ff;
            transform: translateY(-3px);
            box-shadow: 0 15px 40px rgba(0, 242, 254, 0.5);
        }
</style>

<div class="vr-profile-container">
    <div class="profile-header">
        <div>
            <h2 class="page-title">HỒ SƠ PHƯƠNG TIỆN</h2>
            <p class="text-muted mt-2 mb-0" style="color: #8d97ad!important;">Mã định danh hệ thống: #@Model.Id</p>
        </div>
        <a asp-action="Index" class="btn-back-neon">
            <i class='bx bx-radar'></i> Quay lại
        </a>
    </div>

    <div class="row g-5">
        <!-- CỘT TRÁI: GALLERY ẢNH -->
        <div class="col-lg-7">
            <div class="glass-gallery">
                @if (Model.HinhAnhXes != null && Model.HinhAnhXes.Any())
                {
                    var anhChinh = Model.HinhAnhXes.FirstOrDefault(a => a.LaAnhChinh == true) ?? Model.HinhAnhXes.First();
                    var cacAnhPhu = Model.HinhAnhXes.Where(a => a.Id != anhChinh.Id).ToList();

                    <div class="main-image-container">
                        <img src="@anhChinh.DuongDanAnh" class="main-image" alt="@Model.DongXe" id="mainImageDisplay" />
                        @if (anhChinh.LaAnhChinh == true)
                        {
                            <span class="star-badge"><i class='bx bxs-star'></i> Ảnh</span>
                        }
                    </div>

                    @if (cacAnhPhu.Any())
                    {
                        <div class="thumbnail-grid">
                            <!-- Ảnh chính thu nhỏ -->
                            <div class="thumbnail active" onclick="changeImage(this, '@anhChinh.DuongDanAnh')">
                                <img src="@anhChinh.DuongDanAnh" alt="Thumb" />
                            </div>
                            <!-- Các ảnh phụ -->
                            @foreach (var img in cacAnhPhu)
                            {
                                <div class="thumbnail" onclick="changeImage(this, '@img.DuongDanAnh')">
                                    <img src="@img.DuongDanAnh" alt="Thumb" />
                                </div>
                            }
                        </div>
                    }
                }
                else
                {
                    <!-- Giao diện khi không có ảnh (Hologram Error) -->
                    <div class="main-image-container d-flex flex-column align-items-center justify-content-center" style="background: rgba(0,0,0,0.3); border: 1px dashed rgba(255,255,255,0.1);">
                        <i class='bx bx-ghost' style="font-size: 6rem; color: rgba(255,255,255,0.1);"></i>
                        <h4 class="mt-3" style="color: #8d97ad; font-weight: 700; letter-spacing: 2px;">NO VISUAL DATA</h4>
                        <p style="color: rgba(255,255,255,0.3); font-size: 0.9rem;">Hệ thống chưa ghi nhận dữ liệu hình ảnh.</p>
                    </div>
                }
            </div>
        </div>

        <!-- CỘT PHẢI: BẢNG THÔNG SỐ -->
        <div class="col-lg-5">
            <div class="cyber-specs-card">

                <div>
                    <div class="brand-text">@Model.HangXe</div>
                    <h2 class="model-name">@Model.DongXe</h2>

                    <div class="cyber-price-tag">
                        @Model.GiaBan.ToString("N0") <span>VNĐ</span>
                    </div>

                    <div>
                        @if (Model.DaBan == true)
                        {
                            <div class="vr-status-badge status-sold">
                                <i class='bx bx-block'></i> Đã bán
                            </div>
                        }
                        else
                        {
                            <div class="vr-status-badge status-available">
                                <i class='bx bx-broadcast'></i> Còn khả dụng
                            </div>
                        }
                    </div>
                </div>

                <div class="specs-grid">
                    <div class="cyber-spec-item">
                        <div class="spec-icon-vr"><i class='bx bx-barcode-reader'></i></div>
                        <div class="spec-details">
                            <span class="spec-label-vr">Mã định danh (VIN)</span>
                            <span class="spec-value-vr" style="font-family: monospace; color: #00f2fe;">@Model.SoKhungSoMay</span>
                        </div>
                    </div>

                    <div class="cyber-spec-item">
                        <div class="spec-icon-vr"><i class='bx bxs-factory'></i></div>
                        <div class="spec-details">
                            <span class="spec-label-vr">Thương hiệu sản xuất</span>
                            <span class="spec-value-vr">@Model.HangXe</span>
                        </div>
                    </div>

                    <div class="cyber-spec-item">
                        <div class="spec-icon-vr"><i class='bx bx-cube-alt'></i></div>
                        <div class="spec-details">
                            <span class="spec-label-vr">Phân khúc (Model)</span>
                            <span class="spec-value-vr">@Model.DongXe</span>
                        </div>
                    </div>
                </div>

                <div class="action-group-vr">
                    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn-edit-neon">
                        <i class='bx bx-slider'></i> CẬP NHẬT THÔNG SỐ
                    </a>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // JS để tạo hiệu ứng active cho ảnh thu nhỏ khi click
        function changeImage(element, src) {
            // Đổi ảnh lớn
            document.getElementById('mainImageDisplay').src = src;

            // Xóa class active ở tất cả ảnh nhỏ
            var thumbnails = document.querySelectorAll('.thumbnail');
            thumbnails.forEach(function(thumb) {
                thumb.classList.remove('active');
            });

            // Thêm class active cho ảnh vừa click
            element.classList.add('active');
        }
    </script>
}