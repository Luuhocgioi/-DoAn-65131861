<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AutoPro</title>

    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;700;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <style>
            :root {
                --accent-color: #ef233c;
                --accent-solid: #d90429;
                --neon-teal: #00f2fe;
                --bg-obsidian: #08090d;
                --border-glow: rgba(239, 35, 60, 0.15);
            }

            body, html {
                margin: 0;
                padding: 0;
                width: 100%;
                min-height: 100vh;
                font-family: 'Outfit', sans-serif;
                background-color: var(--bg-obsidian);
                /* Tạo vân lưới carbon cơ khí thể thao */
                background-image: 
                    linear-gradient(45deg, rgba(255, 255, 255, 0.003) 25%, transparent 25%), 
                    linear-gradient(-45deg, rgba(255, 255, 255, 0.003) 25%, transparent 25%), 
                    linear-gradient(45deg, transparent 75%, rgba(255, 255, 255, 0.003) 75%), 
                    linear-gradient(-45deg, transparent 75%, rgba(255, 255, 255, 0.003) 75%);
                background-size: 30px 30px;
                color: #ffffff;
                overflow-x: hidden;
            }

            /* 1. LỚP HÌNH NỀN FULL MÀN HÌNH (Gara Siêu Xe Cinematic) */
            .bg-cinematic {
                position: fixed;
                top: 0;
                left: 0;
                width: 100vw;
                height: 100vh;
                z-index: -2;
                background: url('https://images.unsplash.com/photo-1583121274602-3e2820c69888?q=80&w=2070&auto=format&fit=crop') no-repeat center center;
                background-size: cover;
                opacity: 0.45; /* Giảm độ sáng hình nền để nổi bật nội dung phía trước */
            }

            /* 2. LỚP PHỦ ĐEN TRÁI-SANG-PHẢI */
            .bg-overlay {
                position: fixed;
                top: 0;
                left: 0;
                width: 100vw;
                height: 100vh;
                z-index: -1;
                background: radial-gradient(circle at 50% 50%, rgba(8, 9, 13, 0.6) 0%, rgba(8, 9, 13, 0.98) 100%);
            }

            /* 3. THANH ĐIỀU HƯỚNG (NAVBAR) SIÊU MẢNH KÍNH MỜ */
            .gravity-nav {
                display: flex;
                justify-content: space-between;
                align-items: center;
                padding: 30px 80px;
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                z-index: 1000;
                transition: all 0.5s cubic-bezier(0.165, 0.84, 0.44, 1);
                background: rgba(8, 9, 13, 0.3);
                backdrop-filter: blur(10px);
                border-bottom: 1px solid rgba(255, 255, 255, 0.03);
            }

            .gravity-nav.scrolled {
                background: rgba(8, 9, 13, 0.92);
                backdrop-filter: blur(20px);
                padding: 15px 80px;
                border-bottom: 1px solid rgba(239, 35, 60, 0.2);
                box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
            }

            .brand-logo {
                font-size: 1.8rem;
                font-weight: 900;
                color: #fff;
                text-decoration: none;
                letter-spacing: -1px;
                text-transform: uppercase;
                background: linear-gradient(90deg, #ffffff, #8d97ad);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
            }

            .brand-logo span {
                color: var(--accent-color);
                -webkit-text-fill-color: var(--accent-color);
                font-size: 2rem;
            }

            .nav-links {
                display: flex;
                gap: 40px;
                margin: 0;
                padding: 0;
                list-style: none;
            }

            .nav-links a {
                color: rgba(255, 255, 255, 0.6);
                text-decoration: none;
                font-size: 0.95rem;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 1.5px;
                transition: all 0.3s;
                position: relative;
                padding: 5px 0;
            }

            .nav-links a::after {
                content: '';
                position: absolute;
                bottom: 0;
                left: 0;
                width: 100%;
                height: 2px;
                background: linear-gradient(90deg, var(--accent-color), var(--neon-teal));
                transform: scaleX(0);
                transform-origin: right;
                transition: transform 0.3s ease;
            }

            .nav-links a:hover {
                color: #ffffff;
            }

            .nav-links a:hover::after, .nav-links a.active::after {
                transform: scaleX(1);
                transform-origin: left;
            }

            .nav-links a.active {
                color: #ffffff;
            }

            /* Nút Contact bo tròn */
            .btn-gravity {
                background: linear-gradient(135deg, var(--accent-color) 0%, var(--accent-solid) 100%);
                color: #fff !important;
                padding: 10px 30px;
                border-radius: 50px;
                font-weight: 800;
                font-size: 0.9rem;
                text-transform: uppercase;
                letter-spacing: 1px;
                text-decoration: none;
                transition: all 0.3s;
                box-shadow: 0 5px 15px rgba(239, 35, 60, 0.3);
                border: 1px solid rgba(255, 255, 255, 0.1);
            }

            .btn-gravity:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 25px rgba(239, 35, 60, 0.5), 0 0 10px rgba(0, 242, 254, 0.3);
                border-color: rgba(0, 242, 254, 0.5);
            }

            /* 4. VÙNG HIỂN THỊ NỘI DUNG */
            .content-wrapper {
                padding-top: 140px;
                padding-left: 80px;
                padding-right: 80px;
                min-height: 100vh;
                position: relative;
                z-index: 1;
            }

            /* Tinh chỉnh lại Table và Form cho phù hợp nền tối */
            .content-wrapper table {
                background: rgba(255, 255, 255, 0.01);
                color: #fff;
                border-radius: 20px;
                backdrop-filter: blur(15px);
                border: 1px solid rgba(255, 255, 255, 0.03);
            }

            .content-wrapper thead {
                background: rgba(239, 35, 60, 0.05);
                color: var(--accent-color);
            }

            .content-wrapper td, .content-wrapper th {
                border-color: rgba(255, 255, 255, 0.03);
                padding: 18px 20px;
            }

            .form-container {
                background: rgba(255, 255, 255, 0.01);
                backdrop-filter: blur(25px);
                border: 1px solid rgba(255, 255, 255, 0.05);
                border-radius: 24px;
            }

            .form-control-custom {
                background: rgba(0, 0, 0, 0.3);
                color: #fff;
                border-color: rgba(255, 255, 255, 0.08);
                border-radius: 12px;
                padding: 12px;
            }

            .form-control-custom:focus {
                background: rgba(0, 0, 0, 0.5);
                color: #fff;
                border-color: var(--accent-color);
                box-shadow: 0 0 10px rgba(239, 35, 60, 0.2);
            }
    </style>
</head>
<body>
    <div class="bg-cinematic"></div>
    <div class="bg-overlay"></div>

    <nav class="gravity-nav" id="mainNav">
        <a href="/" class="brand-logo">autopro<span>.</span></a>

        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            <ul class="nav-links">
                <li><a asp-controller="Home" asp-action="Index">Tổng Quan</a></li>
                <li><a asp-controller="Xes" asp-action="Index">Kho Xe</a></li>
                <li><a asp-controller="DonHangs" asp-action="Index">Giao Dịch</a></li>
                <li><a asp-controller="NhanViens" asp-action="Index">Nhân Sự</a></li>
            </ul>

            <div class="d-flex align-items-center gap-3">
                <span class="text-white-50" style="font-size: 0.95rem;">
                    <i class='bx bx-user-circle' style="vertical-align: middle; font-size: 1.2rem;"></i> @User.Identity.Name
                </span>
                <a asp-controller="Account" asp-action="Logout" class="btn-gravity">Đăng Xuất</a>
            </div>
        }
        else
        {
            <a asp-controller="Account" asp-action="Login" class="btn-gravity">Đăng Nhập</a>
        }
    </nav>

    <main class="content-wrapper">
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // Hiệu ứng đổi nền Navbar khi cuộn chuột
        $(window).scroll(function() {
        if ($(document).scrollTop() > 50) {
        $('#mainNav').addClass('scrolled');
        } else {
        $('#mainNav').removeClass('scrolled');
        }
        });

        // Tự động Active menu hiện tại
        $(document).ready(function () {
        var currentUrl = window.location.pathname.toLowerCase();
        $('.nav-links a').each(function () {
        var linkUrl = $(this).attr('href').toLowerCase();
        if (currentUrl.startsWith(linkUrl) && linkUrl !== '/') {
        $(this).addClass('active');
        } else if (currentUrl === '/' && linkUrl === '/') {
        $(this).addClass('active');
        }
        });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>