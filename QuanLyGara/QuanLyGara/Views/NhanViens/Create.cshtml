@model QuanLyGara.Models.NhanVien

@{
    ViewData["Title"] = "Cấp Thẻ Nhân Viên";
}

<style>
    :root {
        --primary-color: #2b2d42;
        --accent-color: #ef233c;
        --bg-color: #0f1115;
    }

    .creation-wrapper {
        padding: 20px 0;
    }

    /* Tiêu đề trang */
    .page-header {
        margin-bottom: 40px;
        padding-bottom: 20px;
        border-bottom: 1px solid rgba(255,255,255,0.05);
    }

    .page-title {
        font-size: 2.2rem;
        font-weight: 900;
        color: #fff;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin: 0;
    }

    /* 1. CỘT TRÁI: THẺ PREVIEW (HOLOGRAPHIC ID CARD) */
    .preview-container {
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 20px;
    }

    .hologram-card {
        width: 100%;
        max-width: 350px;
        background: linear-gradient(145deg, rgba(43,45,66,0.8) 0%, rgba(15,17,21,0.9) 100%);
        border: 2px solid rgba(239, 35, 60, 0.3);
        border-radius: 24px;
        padding: 40px 20px;
        text-align: center;
        position: relative;
        box-shadow: 0 20px 50px rgba(239, 35, 60, 0.15);
        overflow: hidden;
    }

        /* Hiệu ứng tia sáng lướt qua thẻ */
        .hologram-card::after {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: linear-gradient(45deg, transparent, rgba(255,255,255,0.05), transparent);
            transform: rotate(45deg);
            animation: hologramSweep 4s infinite linear;
        }

    @@keyframes hologramSweep {
        0% {
            transform: rotate(45deg) translateY(-100%);
        }

        100% {
            transform: rotate(45deg) translateY(100%);
        }
    }

    .preview-avatar {
        width: 120px;
        height: 120px;
        background: rgba(255,255,255,0.05);
        border-radius: 50%;
        margin: 0 auto 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 4rem;
        color: var(--accent-color);
        border: 2px dashed rgba(239, 35, 60, 0.5);
    }

    .preview-name {
        font-size: 1.6rem;
        font-weight: 800;
        color: #fff;
        margin-bottom: 5px;
        min-height: 38px; /* Giữ khung không bị giật khi trống */
    }

    .preview-role {
        display: inline-block;
        background: rgba(0, 242, 254, 0.1);
        color: #00f2fe;
        padding: 6px 20px;
        border-radius: 50px;
        font-size: 0.9rem;
        font-weight: 700;
        text-transform: uppercase;
        margin-bottom: 20px;
        min-height: 33px;
        min-width: 120px;
        border: 1px solid rgba(0, 242, 254, 0.3);
    }

    .preview-phone {
        color: #8d97ad;
        font-size: 1.1rem;
        font-weight: 500;
        letter-spacing: 2px;
        min-height: 26px;
    }

    /* 2. CỘT PHẢI: FORM NHẬP LIỆU (GLASS CONSOLE) */
    .form-console {
        background: rgba(255, 255, 255, 0.02);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 24px;
        padding: 40px;
    }

    .input-group-cyber {
        margin-bottom: 25px;
    }

    .cyber-label {
        color: #8d97ad;
        font-size: 0.85rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 8px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .cyber-label i {
            color: var(--accent-color);
            font-size: 1.2rem;
        }

    .cyber-input {
        width: 100%;
        background: rgba(0, 0, 0, 0.3);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 12px;
        padding: 15px 20px;
        color: #ffffff;
        font-size: 1.1rem;
        transition: all 0.3s;
    }

        .cyber-input:focus {
            outline: none;
            border-color: var(--accent-color);
            box-shadow: 0 0 20px rgba(239, 35, 60, 0.2);
            background: rgba(0, 0, 0, 0.5);
        }

    .action-group {
        display: flex;
        gap: 15px;
        margin-top: 40px;
    }

    .btn-cancel {
        flex: 1;
        background: rgba(255,255,255,0.05);
        color: #fff;
        border: 1px solid rgba(255,255,255,0.1);
        padding: 15px;
        border-radius: 12px;
        font-weight: 600;
        text-align: center;
        text-decoration: none;
        transition: all 0.3s;
    }

        .btn-cancel:hover {
            background: rgba(255,255,255,0.1);
            color: #fff;
        }

    .btn-submit {
        flex: 2;
        background: var(--accent-color);
        color: #fff;
        border: none;
        padding: 15px;
        border-radius: 12px;
        font-weight: 800;
        font-size: 1.1rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        transition: all 0.3s;
        box-shadow: 0 8px 25px rgba(239, 35, 60, 0.4);
    }

        .btn-submit:hover {
            background: #d90429;
            transform: translateY(-3px);
            box-shadow: 0 12px 30px rgba(239, 35, 60, 0.6);
        }
</style>

<div class="creation-wrapper">
    <div class="page-header">
        <h2 class="page-title"><i class='bx bx-fingerprint text-danger me-2'></i> CẤP THẺ NHÂN SỰ MỚI</h2>
        <p class="text-muted mt-2 mb-0" style="color: #8d97ad!important;">Điền thông tin để hệ thống tự động khởi tạo định danh (ID Card).</p>
    </div>

    <div class="row g-5 align-items-center">
        <!-- CỘT TRÁI: LIVE PREVIEW -->
        <div class="col-lg-5 order-2 order-lg-1">
            <div class="preview-container">
                <div class="hologram-card">
                    <div class="preview-avatar">
                        <i class='bx bx-user'></i>
                    </div>
                    <div class="preview-name" id="preview-name">HỌ VÀ TÊN</div>
                    <div class="preview-role" id="preview-role">CHỨC VỤ</div>
                    <div class="preview-phone" id="preview-phone">09xx.xxx.xxx</div>
                </div>
            </div>
            <p class="text-center mt-3" style="color: rgba(255,255,255,0.4); font-size: 0.85rem;">
                <i class='bx bx-scan'></i> Bản xem trước Thẻ Điện Tử
            </p>
        </div>

        <!-- CỘT PHẢI: FORM NHẬP LIỆU -->
        <div class="col-lg-7 order-1 order-lg-2">
            <div class="form-console">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="input-group-cyber">
                        <label asp-for="HoTen" class="cyber-label"><i class='bx bxs-user-rectangle'></i> Họ tên đầy đủ</label>
                        <input asp-for="HoTen" class="cyber-input" id="input-name" placeholder="VD: Nguyễn Văn A" autocomplete="off" required />
                        <span asp-validation-for="HoTen" class="text-danger mt-1 d-block" style="font-size: 0.85rem;"></span>
                    </div>

                    <div class="input-group-cyber">
                        <label asp-for="ChucVu" class="cyber-label"><i class='bx bx-target-lock'></i> Vị trí / Chức vụ</label>
                        <input asp-for="ChucVu" class="cyber-input" id="input-role" placeholder="VD: Kỹ Thuật Viên, Sale, Quản Lý..." autocomplete="off" required />
                        <span asp-validation-for="ChucVu" class="text-danger mt-1 d-block" style="font-size: 0.85rem;"></span>
                    </div>

                    <div class="input-group-cyber">
                        <label asp-for="SoDienThoai" class="cyber-label"><i class='bx bx-phone-call'></i> Số điện thoại liên hệ</label>
                        <input asp-for="SoDienThoai" class="cyber-input" id="input-phone" placeholder="VD: 0987654321" autocomplete="off" required />
                        <span asp-validation-for="SoDienThoai" class="text-danger mt-1 d-block" style="font-size: 0.85rem;"></span>
                    </div>

                    <div class="action-group">
                        <a asp-action="Index" class="btn-cancel"><i class='bx bx-x'></i> Hủy Bỏ</a>
                        <button type="submit" class="btn-submit"><i class='bx bx-chip'></i> GHI DỮ LIỆU & CẤP THẺ</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <!-- SCRIPT TẠO HIỆU ỨNG GÕ PHÍM ĐẾN ĐÂU, HIỂN THỊ ĐẾN ĐÓ -->
    <script>
        $(document).ready(function () {
            // Lắng nghe sự kiện gõ phím ở ô Họ Tên
            $('#input-name').on('input', function () {
                var val = $(this).val();
                $('#preview-name').text(val ? val.toUpperCase() : 'HỌ VÀ TÊN');
            });

            // Lắng nghe sự kiện gõ phím ở ô Chức vụ
            $('#input-role').on('input', function () {
                var val = $(this).val();
                $('#preview-role').text(val ? val.toUpperCase() : 'CHỨC VỤ');
            });

            // Lắng nghe sự kiện gõ phím ở ô Số điện thoại
            $('#input-phone').on('input', function () {
                var val = $(this).val();
                // Định dạng số điện thoại thêm dấu chấm cho đẹp (VD: 098.765.4321)
                if (val.length >= 10) {
                    val = val.replace(/(\d{3})(\d{3})(\d{4})/, "$1.$2.$3");
                }
                $('#preview-phone').text(val ? val : '09xx.xxx.xxx');
            });
        });
    </script>
}